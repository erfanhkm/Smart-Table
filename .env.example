# ---- Server ----
# production | development. In production the app REFUSES TO BOOT unless
# STAFF_API_TOKEN (>= 32 chars) and SQUARE_WEBHOOK_SIGNATURE_KEY are set and PG_MEM is not 1.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Set to 1 when running behind a reverse proxy / load balancer that sets X-Forwarded-Proto/Host.
# The webhook signature URL is then derived from those headers instead of APP_URL.
TRUST_PROXY=
# Postgres connection string (docker-compose sets this for the api service).
# For local dev without docker you can run: PG_MEM=1 npm run dev  (in-memory DB, data is lost on restart; refused in production)
DATABASE_URL=postgres://smarttable:CHANGE_ME@localhost:5432/smarttable
# docker-compose only: password for the bundled Postgres (never use a default).
POSTGRES_PASSWORD=

# ---- Staff API ----
# Bearer token required by every staff endpoint and the dashboard UI. Generate: openssl rand -hex 32
# Empty = all staff endpoints answer 401.
STAFF_API_TOKEN=

# ---- Square ----
# sandbox | production
SQUARE_ENV=sandbox
# Sandbox access token from the Square Developer Console (Credentials page).
# NEVER commit a real token. For local dev, export it in your shell instead of writing it here.
SQUARE_ACCESS_TOKEN=
# Default sandbox/production location ID, e.g. from the Developer Console Locations page.
SQUARE_LOCATION_ID=
# OAuth app credentials (needed for real restaurant onboarding; not needed for sandbox spike tests)
SQUARE_APP_ID=
SQUARE_APP_SECRET=
# Webhook signature key (Developer Console -> Webhooks). REQUIRED in production.
# Empty in non-production = webhooks are accepted unverified, with a loud warning per request.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ---- Security ----
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
# Used to encrypt Square OAuth tokens at rest.
ENCRYPTION_KEY=
