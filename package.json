{
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.0"
  },
  "description": "Smart Table MVP — guest payment + live table management on top of Square",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "name": "smart-table",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx scripts/migrate-cli.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate:prod": "node dist/migrate-cli.js",
    "test": "PG_MEM=1 tsx --test tests/*.test.ts"
  },
  "type": "module",
  "version": "0.6.5"
}
